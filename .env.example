# Copy to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side auth rate limits (Supabase Edge Functions). After deploying functions
# and applying the auth_rate_events table from supabase/schema.sql, set:
# NEXT_PUBLIC_AUTH_VIA_EDGE_FUNCTIONS=true
# Leave unset or false to use direct Supabase auth (client-only rate limit UX).

# Dev only: skip login and load dashboard with a mock user — for UI/perf checks.
# Omit or set false for normal login testing.
# NEXT_PUBLIC_PREVIEW_DASHBOARD=true
